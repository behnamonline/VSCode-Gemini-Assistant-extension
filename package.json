{
  "name": "gemini-assistant",
  "displayName": "Gemini Assistant",
  "description": "AI Coding Assistant powered by Google Gemini API",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/behnamonline/VSCode-Gemini-Assistant-extension.git"
  },
  "engines": {
    "vscode": "^1.136.1"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "geminiAssistantContainer",
          "title": "Gemini Assistant",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "geminiAssistantContainer": [
        {
          "type": "webview",
          "id": "geminiAssistantView",
          "name": "بهنام آنلاین"
        }
      ]
    },
    "commands": [
      {
        "command": "gemini-assistant.helloWorld",
        "title": "Gemini: Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.136.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}